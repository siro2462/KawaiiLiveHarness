{
  "samples": [
    {
      "call_id": "R0001",
      "sample_id": "M06",
      "spans": [
        {
          "kind": "F",
          "text": "あ、サイズを測ってから買ってるから、"
        },
        {
          "kind": "E",
          "text": "見た目もその通りに入ると思ってたんだよね。"
        }
      ]
    },
    {
      "call_id": "R0002",
      "sample_id": "M06",
      "spans": [
        {
          "kind": "E",
          "text": "布ものとかも足して、部屋でゆっくり過ごせる雰囲気にしたかったんだよね。"
        }
      ]
    },
    {
      "call_id": "R0003",
      "sample_id": "M06",
      "spans": [
        {
          "kind": "E",
          "text": "あれ、……なんだろう。"
        },
        {
          "kind": "T",
          "text": "買い足した分だけ、ゆっくりできるわけじゃないのかな。"
        }
      ]
    },
    {
      "call_id": "R0004",
      "sample_id": "M06",
      "spans": [
        {
          "kind": "T",
          "text": "やっぱり、測るだけじゃなくて。……布とかの存在感とか、視界の詰まり具合は数字だけじゃ分かんないよね。"
        }
      ]
    },
    {
      "call_id": "R0005",
      "sample_id": "M06",
      "spans": [
        {
          "kind": "F",
          "text": "あ、ニトリでカーテンと、無印でクッション買った。……置いてみたんだよね。"
        }
      ]
    },
    {
      "call_id": "R0006",
      "sample_id": "M06",
      "spans": [
        {
          "kind": "T",
          "text": "あ、一個ずつなら好きだけど、同じ場所にまとめるとまた違う感じがするんだよね。"
        }
      ]
    },
    {
      "call_id": "R0007",
      "sample_id": "M06",
      "spans": [
        {
          "kind": "F",
          "text": "あ、ニトリのカーテンと無印のクッション、置いてみたんだよね。"
        }
      ]
    },
    {
      "call_id": "R0008",
      "sample_id": "M06",
      "spans": [
        {
          "kind": "T",
          "text": "やっぱり、買ったものを残すことより、自分の感覚を優先してよかったと思いたいな。"
        }
      ]
    },
    {
      "call_id": "R0009",
      "sample_id": "M06",
      "spans": [
        {
          "kind": "T",
          "text": "やっぱり、サイズを測ってても実際に置くとイメージと違うことあるよね。"
        }
      ]
    },
    {
      "call_id": "R0010",
      "sample_id": "M06",
      "spans": [
        {
          "kind": "T",
          "text": "買い足す前に、今の状態で一度部屋をじっくり眺めたいな。"
        }
      ]
    },
    {
      "call_id": "R0011",
      "sample_id": "M06",
      "spans": [
        {
          "kind": "F",
          "text": "圧迫感が出たから、半分は返品して、片付けたんだよね。"
        }
      ]
    },
    {
      "call_id": "R0012",
      "sample_id": "M06",
      "spans": [
        {
          "kind": "E",
          "text": "うーん、かといって、せっかく選んだのにって思うし……。"
        }
      ]
    },
    {
      "call_id": "R0013",
      "sample_id": "M06",
      "spans": [
        {
          "kind": "T",
          "text": "次は一種類ずつ置いてみれば、圧迫感が出るタイミングが分かるのかな。"
        }
      ]
    },
    {
      "call_id": "R0014",
      "sample_id": "M06",
      "spans": [
        {
          "kind": "F",
          "text": "あ、結局、半分は返品した。……圧迫感あったから。"
        }
      ]
    },
    {
      "call_id": "R0015",
      "sample_id": "M17",
      "spans": [
        {
          "kind": "F",
          "text": "最近、学校に遅刻しそうで走る夢を見たんだよね。"
        }
      ]
    },
    {
      "call_id": "R0016",
      "sample_id": "M17",
      "spans": [
        {
          "kind": "E",
          "text": "はあ……、目が覚めたらもう行かなくていいんだって思って。……夢の中でも急かされてたんだよね。"
        }
      ]
    },
    {
      "call_id": "R0017",
      "sample_id": "M17",
      "spans": [
        {
          "kind": "T",
          "text": "なんか、景色っていうか……。自分が気にしてる内容が、より現実っぽくなってる感じがするんだよね。"
        }
      ]
    },
    {
      "call_id": "R0018",
      "sample_id": "M17",
      "spans": [
        {
          "kind": "F",
          "text": "あ、大人になってからは、なんか現実的な内容の夢が増えた気がする。"
        }
      ]
    },
    {
      "call_id": "R0019",
      "sample_id": "M17",
      "spans": [
        {
          "kind": "T",
          "text": "……ん、自由な夢が減ったのかな。それとも、焦る方の夢をよく覚えてるだけ？"
        }
      ]
    },
    {
      "call_id": "R0020",
      "sample_id": "M17",
      "spans": [
        {
          "kind": "F",
          "text": "やっぱり、大人になってからは現実的な夢が増えた気がする。"
        }
      ]
    },
    {
      "call_id": "R0021",
      "sample_id": "M17",
      "spans": [
        {
          "kind": "E",
          "text": "あ、また空飛ぶ夢を見たら、その感覚を覚えておきたいな。"
        }
      ]
    },
    {
      "call_id": "R0022",
      "sample_id": "M17",
      "spans": [
        {
          "kind": "F",
          "text": "あ、子どもの頃は空飛ぶ夢をよく見てたな。"
        }
      ]
    },
    {
      "call_id": "R0023",
      "sample_id": "M17",
      "spans": [
        {
          "kind": "E",
          "text": "え、飛べたのに。"
        },
        {
          "kind": "F",
          "text": "最近は走るばっかりで、"
        },
        {
          "kind": "E",
          "text": "なんか変な感じ。"
        }
      ]
    },
    {
      "call_id": "R0024",
      "sample_id": "M17",
      "spans": [
        {
          "kind": "T",
          "text": "あ、他に印象的な夢があったら、一言だけメモしておきたいな。"
        }
      ]
    },
    {
      "call_id": "R0025",
      "sample_id": "M17",
      "spans": [
        {
          "kind": "F",
          "text": "あ、そういえば、子どもの頃は知らない人と友達になる夢もよく見てたな。"
        }
      ]
    },
    {
      "call_id": "R0026",
      "sample_id": "M17",
      "spans": [
        {
          "kind": "E",
          "text": "はあ、せめて夢の中くらいは、時間を気にせず自由に動きたいな。"
        }
      ]
    },
    {
      "call_id": "R0027",
      "sample_id": "M17",
      "spans": [
        {
          "kind": "T",
          "text": "あ、いや、夢が忙しいからって、現実でも遅刻しそうだったわけじゃないよ。"
        }
      ]
    },
    {
      "call_id": "R0028",
      "sample_id": "M17",
      "spans": [
        {
          "kind": "F",
          "text": "あ、最近、学校に遅刻しそうで走る夢を見るんだよね。"
        }
      ]
    },
    {
      "call_id": "R0029",
      "sample_id": "M23",
      "spans": [
        {
          "kind": "E",
          "text": "……あ、失敗した時の恥ずかしさも、成功した時の達成感も、どっちも強烈だったな。"
        }
      ]
    },
    {
      "call_id": "R0030",
      "sample_id": "M23",
      "spans": [
        {
          "kind": "E",
          "text": "……うわ、マットに落ちたとき、立ち上がるまでずっと見られてる気がして。"
        }
      ]
    },
    {
      "call_id": "R0031",
      "sample_id": "M23",
      "spans": [
        {
          "kind": "T",
          "text": "……いや、実際はどれくらい見てたのかな。自分の恥ずかしさで、勝手に大きく感じてただけかも。"
        }
      ]
    },
    {
      "call_id": "R0032",
      "sample_id": "M23",
      "spans": [
        {
          "kind": "F",
          "text": "あ、先生に言われて段数を上げたんだけど、失敗してマットに落ちちゃったんだよね。"
        }
      ]
    },
    {
      "call_id": "R0033",
      "sample_id": "M23",
      "spans": [
        {
          "kind": "E",
          "text": "え、一段ってこんなに違うんだ。……急に大きく見えたんだよね。"
        }
      ]
    },
    {
      "call_id": "R0034",
      "sample_id": "M23",
      "spans": [
        {
          "kind": "E",
          "text": "え、怖かったのは……。"
        },
        {
          "kind": "T",
          "text": "自分でも、あんな高さまで助走してたの、忘れてそう。"
        }
      ]
    },
    {
      "call_id": "R0035",
      "sample_id": "M23",
      "spans": [
        {
          "kind": "F",
          "text": "あ、先生に言われて段数を上げたんだけど、失敗してマットに落ちちゃったんだよね。"
        }
      ]
    },
    {
      "call_id": "R0036",
      "sample_id": "M23",
      "spans": [
        {
          "kind": "E",
          "text": "段が増えても、助走の勢いで越えられたら格好いいなって思ってたんだよね。"
        }
      ]
    },
    {
      "call_id": "R0037",
      "sample_id": "M23",
      "spans": [
        {
          "kind": "F",
          "text": "あ、小学校の体育で跳び箱やってたんだよね。"
        }
      ]
    },
    {
      "call_id": "R0038",
      "sample_id": "M23",
      "spans": [
        {
          "kind": "T",
          "text": "……いや、成功したからって、あの時の恥ずかしさが消えるわけでもないんだよね。両方残ってる感じ。"
        }
      ]
    },
    {
      "call_id": "R0039",
      "sample_id": "M23",
      "spans": [
        {
          "kind": "T",
          "text": "数字の一段って、たったそれだけに見えるけど、助走を始める側としてはまた別の挑戦だったんだよね。"
        }
      ]
    },
    {
      "call_id": "R0040",
      "sample_id": "M23",
      "spans": [
        {
          "kind": "E",
          "text": "あー……次は、目立つことより、とにかく落ち着いて手をつくのを優先したかったんだよね。"
        }
      ]
    }
  ],
