  },
  {
    "topic": "H06",
    "line": 33,
    "chunk_id": "L5",
    "human_operation": "REVISIT",
    "text": "回して出ませんでした。",
    "dominant_color": "F",
    "color_counts": {
      "F": 11,
      "E": 0,
      "T": 0
    }
  },
  {
    "topic": "H06",
    "line": 34,
    "chunk_id": "L5",
    "human_operation": "REACTION",
    "text": "はあ。",
    "dominant_color": "E",
    "color_counts": {
      "F": 0,
