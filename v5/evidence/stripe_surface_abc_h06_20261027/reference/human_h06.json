      "T": 0
    }
  },
  {
    "topic": "H06",
    "line": 35,
    "chunk_id": "L6",
    "human_operation": "EVIDENCE",
    "text": "え、A賞の景品はめっちゃ置いてあったよ。",
    "dominant_color": "F",
    "color_counts": {
